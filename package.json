{
  "name": "codex-dsh-trace",
  "private": true,
  "version": "0.2.22",
  "scripts": {
    "build": "node scripts/build-plugin.mjs",
    "test": "npm run test:python && npm run test:node",
    "test:python": "python3 -m unittest discover -s tests -v",
    "test:node": "node --test tests/*.mjs",
    "test:e2e": "playwright test --config tests/e2e/playwright.config.js",
    "test:coverage": "uv run coverage run -m unittest discover -s tests && uv run coverage report && c8 --reports-dir=.cache/coverage/javascript --temp-directory=.cache/coverage/v8 --include=src/host.js --include=src/trajectory-order.js --include=src/errors.js --check-coverage --lines=80 --branches=65 --functions=80 node --test tests/*.mjs",
    "lint": "eslint src scripts tests packages *.js && uv run ruff check",
    "format": "prettier --write . && uv run ruff format",
    "format:check": "prettier --check . && uv run ruff format --check",
    "typecheck": "uv run mypy",
    "check:generated": "node scripts/check-generated.mjs",
    "package": "node scripts/package-plugin.mjs",
    "package:npm": "node scripts/build-npm-package.mjs",
    "demo": "python3 scripts/demo.py",
    "demo:installer": "python3 scripts/preview-installer.py",
    "benchmark": "python3 scripts/benchmark.py",
    "check": "npm run lint && npm run format:check && npm run typecheck && npm test && npm run check:generated",
    "clean": "python3 scripts/clean.py",
    "test:npm": "node --test tests/npm/*.mjs",
    "reconcile": "python3 scripts/reconcile.py"
  },
  "dependencies": {
    "@shikijs/langs": "4.4.3",
    "@tanstack/react-virtual": "3.14.10",
    "clsx": "2.1.1",
    "diff": "9.0.0",
    "katex": "0.18.7",
    "mdast-util-from-markdown": "2.0.3",
    "mdast-util-gfm": "3.1.0",
    "mdast-util-math": "3.0.0",
    "micromark-core-commonmark": "2.0.3",
    "micromark-extension-gfm": "3.0.0",
    "micromark-extension-math": "3.1.0",
    "micromark-factory-space": "2.0.1",
    "micromark-util-character": "2.1.1",
    "micromark-util-classify-character": "2.0.1",
    "micromark-util-decode-string": "2.0.1",
    "micromark-util-sanitize-uri": "2.0.1",
    "micromark-util-symbol": "2.0.1",
    "mime": "4.1.1",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "shiki": "4.4.3",
    "simple-icons": "16.31.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.65.1",
    "c8": "12.0.0",
    "esbuild": "0.25.5",
    "eslint": "10.15.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "globals": "17.14.0",
    "prettier": "3.10.1"
  },
  "type": "module",
  "engines": {
    "node": ">=20.19"
  },
  "overrides": {
    "test-exclude": {
      "glob": "^14.0.6",
      "minimatch": "^11.0.1"
    }
  },
  "prettier": {
    "singleQuote": true,
    "printWidth": 100,
    "trailingComma": "all"
  }
}
